# Naql.ai — Root Environment Variables
# Copy this file to .env and fill in the values

# ============================================================
# Infrastructure
# ============================================================

# CockroachDB
COCKROACH_URL=postgresql+asyncpg://root@localhost:26257/naql

# TimescaleDB
TIMESCALE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/naql_telemetry

# Redis Stack
REDIS_URL=redis://localhost:6379/0

# NATS JetStream
NATS_URL=nats://localhost:4222

# EMQX (MQTT Broker)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883

# ============================================================
# External APIs (Required for production)
# ============================================================

# OpenAI (Agent Brain)
OPENAI_API_KEY=

# Pinecone (Vector Memory / RAG)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=naql-agent-memory
PINECONE_ENVIRONMENT=us-east-1

# Payment Gateways (Egyptian)
FAWRY_API_KEY=
FAWRY_SECRET=
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=

# ============================================================
# Auth
# ============================================================

# JWT — MUST change in production
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
